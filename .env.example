# ---------------------------------------------------------------------------
# Application under test
# ---------------------------------------------------------------------------
BASE_URL=https://sauce-demo.myshopify.com

# Run browser with a visible UI (true = headless, false = headed)
HEADLESS=true

# ---------------------------------------------------------------------------
# Self-healing AI locator engine
# ---------------------------------------------------------------------------
# Master switch. When false, only the static fallback locators are tried and
# no AI call is made (useful in CI without an API key).
AI_HEALING_ENABLED=true

# Provider for runtime AI locator healing. All options below have a free tier
# and expose an OpenAI-compatible /chat/completions endpoint.
#   groq        -> https://console.groq.com  (fast, generous free tier)  [default]
#   gemini      -> https://aistudio.google.com/apikey  (Google, free tier)
#   openrouter  -> https://openrouter.ai/keys  (free ':free' models)
AI_PROVIDER=gemini

# API key for the chosen provider. Leave blank to disable AI healing at runtime.
AI_API_KEY=

# Optional: override the default model for the chosen provider.
#   groq       -> llama-3.3-70b-versatile
#   gemini     -> gemini-2.0-flash
#   openrouter -> meta-llama/llama-3.3-70b-instruct:free
AI_MODEL=gemini-2.0-flash
