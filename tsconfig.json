{
  "compilerOptions": {
    "target": "ES2021",
    "module": "CommonJS",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["node"],
    "lib": ["ES2021", "DOM"]
  },
  "include": ["src/**/*.js", "playwright.config.js"],
  "exclude": ["node_modules", "tests", ".features-gen", "reports"]
}
